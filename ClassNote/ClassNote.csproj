<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 提示词构造与分段逻辑是纯函数，允许测试项目直接覆盖（否则"保真要求"无法回归验证） -->
    <InternalsVisibleTo Include="ClassNote.Tests" />
    <!--
      NoteBench 是"边录边转写 = 整文件转写"的实测工具：它必须驱动**生产代码里的同一个块推理入口**
      （SenseVoiceSttService.TranscribeChunk）才能证明两条路产出相同。
      为此放开 internal 可见性，而不是把这个内部接缝提升为公开 API——公开出去就再也收不回来了。
    -->
    <InternalsVisibleTo Include="NoteBench" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <None Include="models\sensevoice\model_quant.onnx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\sensevoice\tokens.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="models\sensevoice\am.mvn" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\mathjax-tex-svg.js" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
  </ItemGroup>
</Project>