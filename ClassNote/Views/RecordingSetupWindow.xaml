<Window x:Class="ClassNote.Views.RecordingSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始记录 - 配置"
        Height="474" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="开始一段新的课堂记录" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="确认课程、填写标题并选择麦克风。" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="课程" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <ComboBox Grid.Row="2" x:Name="CourseCombo" Margin="0,0,0,14" />

        <TextBlock Grid.Row="3" Text="标题（可选）" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <TextBox Grid.Row="4" x:Name="TitleBox" Margin="0,0,0,14" MaxLength="128" />

        <TextBlock Grid.Row="5" Text="麦克风" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <!-- 麦克风模块放在 Auto 行：提示文字按自然高度完整渲染，不会被压缩行裁剪 -->
        <StackPanel Grid.Row="6">
            <ComboBox x:Name="MicCombo" />
            <TextBlock x:Name="MicHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                       TextWrapping="Wrap" Margin="2,6,0,0" />
        </StackPanel>

        <!-- 弹性空白行：吸收剩余高度，把按钮固定在底部，避免挤占上方内容 -->
        <Grid Grid.Row="7" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButtonStyle}" Width="92" Height="36"
                    Margin="0,0,12,0" Click="CancelButton_Click" />
            <Button Content="开始录制" Style="{StaticResource PrimaryButtonStyle}" Width="112" Height="36"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
