<Window x:Class="ClassNote.Views.RecordingSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始记录 - 配置"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="课程"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <ComboBox Grid.Row="1" x:Name="CourseCombo"
                  Height="34" Margin="0,0,0,16"
                  BorderBrush="#CCC" />

        <TextBlock Grid.Row="2" Text="标题（可选）"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" x:Name="TitleBox"
                 Height="34" Margin="0,0,0,16"
                 BorderBrush="#CCC"
                 VerticalContentAlignment="Center"
                 MaxLength="128" />

        <TextBlock Grid.Row="4" Text="麦克风"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <StackPanel Grid.Row="5" VerticalAlignment="Top">
            <ComboBox x:Name="MicCombo"
                      Height="34" Margin="0,0,0,4"
                      BorderBrush="#CCC" />
            <TextBlock x:Name="MicHint"
                       FontSize="11" Foreground="#999"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="36"
                    Margin="0,0,12,0"
                    Background="#EEE" Foreground="#333"
                    Click="CancelButton_Click" />
            <Button Content="开始录制" Width="110" Height="36"
                    Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                    Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
