<Window x:Class="ClassNote.Views.ScheduleEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑课表条目"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" Text="添加课表条目" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="到点自动开始录音，下课时间自动结束。同一时间只允许一节课。" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="课程名称" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <ComboBox x:Name="CourseBox" Grid.Row="2" Margin="0,0,0,12"
                  ToolTip="从列表中选择课程：内置 9 门 + 你已录入过的课程名（不支持手输）" />

        <TextBlock Grid.Row="3" Text="备注（可选，如章节/教室）" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="TitleBox" Grid.Row="4" MaxLength="128" Margin="0,0,0,12" />

        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="星期" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="WeekdayBox" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="时间段" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StartBox" Grid.Column="0" MaxLength="5" ToolTip="开始时间，如 08:00" />
                    <TextBlock Grid.Column="1" Text="–" FontSize="14" Margin="8,0,8,0"
                               Foreground="{StaticResource TextHintBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="EndBox" Grid.Column="2" MaxLength="5" ToolTip="结束时间，如 09:40" />
                </Grid>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="EnabledBox" Grid.Row="6" Content="参与定时自动录音（取消勾选可临时停用）"
                  FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="True"
                  Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Grid.Row="7" FontSize="11" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <Border Grid.Row="8" Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                Padding="12,9" Margin="0,2,0,6">
            <TextBlock x:Name="DurationHint" FontSize="11" Foreground="#33415C" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="9" />

        <DockPanel Grid.Row="13" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerGhostButtonStyle}"
                    Width="72" Height="34" Click="DeleteButton_Click" DockPanel.Dock="Left"
                    Visibility="Collapsed" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButtonStyle}" Width="84" Height="34"
                        Margin="12,0,0,0" Click="CancelButton_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Width="84" Height="34"
                        Margin="12,0,0,0" Click="SaveButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
