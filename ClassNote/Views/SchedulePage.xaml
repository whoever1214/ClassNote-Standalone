<Page x:Class="ClassNote.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1040"
      Title="ClassNote - 定时记录 · 每周课表"
      Loaded="Page_Loaded">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <DockPanel Margin="26,18,26,22">
        <!-- 顶部：返回 + 标题 + 总开关 / 自启 / 课程安排 -->
        <Grid DockPanel.Dock="Top" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Height="34" Padding="14,0"
                        Click="BackButton_Click" ToolTip="返回主页">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="定时记录 · 每周课表" FontSize="18" FontWeight="Bold"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="MasterHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="MasterToggle" FontSize="12" FontWeight="SemiBold"
                          Content="开启定时记录" VerticalAlignment="Center"
                          Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"
                          ToolTip="开启后到点自动开始录音、下课自动结束；需要应用保持运行" />
                <CheckBox x:Name="LaunchToggle" FontSize="12" Content="开机自启"
                          Margin="18,0,0,0" VerticalAlignment="Center"
                          Checked="LaunchToggle_Changed" Unchecked="LaunchToggle_Changed"
                          ToolTip="随 Windows 登录启动并驻留托盘（后台运行课表照常触发）" />
                <Button x:Name="EditButton" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                        Padding="22,0,20,0" Margin="20,0,0,0" Click="EditButton_Click"
                        ToolTip="唯一的课表编辑入口：在这里添加 / 修改 / 删除课程">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#33FFFFFF" CornerRadius="7" Padding="7,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="White" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="课程安排" FontSize="15" VerticalAlignment="Center"
                                   Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 说明条 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                Padding="14,8" Margin="2,0,2,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#33415C"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 课表展示区：只读，点击「课程安排」按钮才能编辑 -->
        <Border DockPanel.Dock="Bottom" Background="Transparent" Padding="2,8,2,0"
                HorizontalAlignment="Left">
            <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                       Text="时间轴固定显示 05:00–22:00；「课程安排」为唯一编辑入口，改完自动刷新本视图。" />
        </Border>

        <!-- 24 小时周课表网格（只读展示） -->
        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="WeekHeader" Height="34" />
                <ScrollViewer Grid.Row="1" x:Name="WeekScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel x:Name="WeekColumns" Orientation="Horizontal" />
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Page>
