<Page x:Class="ClassNote.Views.RecordingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1040"
      Title="ClassNote - 录音记录"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Page.Resources>
        <!-- 录音指示光环：仅在"录音中"时持续呼吸脉动 -->
        <Style x:Key="HaloStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Fill" Value="#33E5484D" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="录音中">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="HaloSB">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.6" To="1.75" Duration="0:0:1.7">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.6" To="1.75" Duration="0:0:1.7">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.7">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="HaloSB" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F8FC" Offset="0" />
                <GradientStop Color="#EDF0F8" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 显示课程名与声音来源的角标（页面右上角） -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0"
                Background="#33FFFFFF" CornerRadius="10" Padding="12,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="课程：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CourseLabel" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SourceLabel" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 定时自动结束角标（仅课表定时触发的录音显示；到点自动停止） -->
        <Border x:Name="ScheduleBadge" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,22,0"
                Background="#14F59E0B" CornerRadius="10" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="#B26A00" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="ScheduleBadgeText" FontSize="12" FontWeight="SemiBold"
                           Foreground="#8A5200" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Width="540" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource CardBorderStyle}">
            <Grid Margin="36,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 状态指示 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse x:Name="Halo" Style="{StaticResource HaloStyle}" />
                        <Ellipse x:Name="RecordingDot" Width="12" Height="12" Fill="#E5484D"
                                 VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}"
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 大计时器 -->
                <TextBlock Grid.Row="1" Text="{Binding ElapsedDisplay}"
                           FontFamily="Consolas" FontSize="56" FontWeight="Regular"
                           HorizontalAlignment="Center" Margin="0,16,0,4"
                           Foreground="#262B33" />

                <!-- 统计信息 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,26">
                    <Border Background="#F4F5F8" CornerRadius="10" Padding="14,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="截图" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScreenshotCount}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F4F5F8" CornerRadius="10" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="每 10 秒自动截屏" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 分隔线 -->
                <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,20" />

                <!-- 保存进度 -->
                <StackPanel Grid.Row="4" Margin="0,0,0,22">
                    <ProgressBar x:Name="UploadProgressBar" Height="6" IsIndeterminate="True"
                                 Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock x:Name="UploadStatusText" Text="正在自动保存截图与录音…"
                               FontSize="11" Foreground="{StaticResource TextHintBrush}"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                </StackPanel>

                <!-- 麦克风选择：仅当本次来源包含麦克风时显示 -->
                <StackPanel Grid.Row="5" Margin="0,0,0,22"
                            Visibility="{Binding UsesMicrophone, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="麦克风" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableMics}"
                              SelectedItem="{Binding SelectedMic, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 仅采集系统声音时说明录制对象，避免用户以为"没在录" -->
                <Border Grid.Row="5" Margin="0,0,0,22" Background="#F4F5F8" CornerRadius="10" Padding="14,10"
                        Visibility="{Binding UsesMicrophone, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center"
                                   Text="正在录制系统声音：请让课件 / 视频在所选播放设备上出声。" />
                    </StackPanel>
                </Border>

                <!-- 结束录音 -->
                <Button Grid.Row="6" x:Name="EndButton" Style="{StaticResource DangerButtonStyle}"
                        Height="46" Click="EndButton_Click" Content="结束录音" ToolTip="停止录音并快速回到主页" />
            </Grid>
        </Border>
    </Grid>
</Page>
