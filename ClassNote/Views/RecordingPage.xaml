<Page x:Class="ClassNote.Views.RecordingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="ClassNote - 录音记录"
      Loaded="Page_Loaded" Unloaded="Page_Unloaded">

    <Grid>
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="24"
                Background="White">
            <StackPanel>
                <!-- Status Indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse x:Name="RecordingDot" Width="12" Height="12"
                             Fill="#4CAF50" VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusLabel"
                               Text="{Binding StatusText}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Recording Duration (large timer) -->
                <TextBlock Text="{Binding ElapsedDisplay}"
                           FontSize="48" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16"
                           Foreground="#333" />

                <!-- Stats Row: Screenshot Count + Video URLs Found -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Text="截图: " FontSize="14" Foreground="#666" />
                        <TextBlock Text="{Binding ScreenshotCount}" FontSize="14" FontWeight="Bold" Foreground="#1976D2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="课程: " FontSize="14" Foreground="#666" />
                        <TextBlock x:Name="CourseLabel" FontSize="14" FontWeight="Bold" Foreground="#1976D2" />
                    </StackPanel>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,16" />

                <!-- Upload Progress (indeterminate while recording) -->
                <ProgressBar Height="6" Margin="0,0,0,4"
                             IsIndeterminate="True"
                             Foreground="#1976D2"
                             x:Name="UploadProgressBar" />

                <TextBlock Text="正在上传截图..."
                           FontSize="11" Foreground="#999"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           x:Name="UploadStatusText" />

                <!-- Microphone Selector -->
                <TextBlock Text="麦克风" FontSize="13" Foreground="#555" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AvailableMics}"
                          SelectedItem="{Binding SelectedMic, UpdateSourceTrigger=PropertyChanged}"
                          Height="34"
                          Margin="0,0,0,20"
                          BorderBrush="#CCC" />

                <!-- End Recording Button -->
                <Button x:Name="EndButton"
                        Content="结束录音"
                        Height="44"
                        Background="#D32F2F" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        Click="EndButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
