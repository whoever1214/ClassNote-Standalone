<Window x:Class="ClassNote.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - LLM API 配置"
        Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 表单内容放在 ScrollViewer 中：窗口空间不足时可用鼠标滚轮上下滚动 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
            <StackPanel>

                <TextBlock Text="LLM 笔记生成配置" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="STT 与 OCR 完全离线运行，仅生成笔记时需要联网。" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18" />

                <TextBlock Text="API 基础地址（OpenAI 兼容，默认 DeepSeek）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="BaseUrlBox" Margin="0,0,0,14" />

                <TextBlock Text="LLM API Key" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="ApiKeyBox" Margin="0,0,0,14" />

                <TextBlock Text="模型名称" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="ModelBox" Margin="0,0,0,14" />

                <TextBlock Text="请求超时（秒）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TimeoutBox" Margin="0,0,0,4" />
                <TextBlock Text="本地模型推理较慢时请调大（范围 60–7200，默认 1800 = 30 分钟），可减少超时报错。"
                           FontSize="11" Foreground="{StaticResource TextHintBrush}"
                           TextWrapping="Wrap" Margin="2,0,0,14" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource GhostButtonStyle}"
                            Width="96" Height="32" Click="TestButton_Click" />
                    <TextBlock x:Name="TestResultText" FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Text="备用 API Key（可选，主配置失败时自动切换）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="FallbackApiKeyBox" Margin="0,0,0,14" />

                <TextBlock Text="备用 API 基础地址（可选）" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="FallbackBaseUrlBox" Margin="0,0,0,14" />

                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                        Padding="14,10" Margin="0,6,0,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock FontSize="12" Foreground="#33415C" TextWrapping="Wrap" MaxWidth="430"
                                   Text="说明：本软件为单机离线运行，STT 与 OCR 在本地完成，仅 LLM 笔记生成需要 API Key。Key 仅保存在本机（DPAPI 加密）。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区域独立于滚动区之外，固定在窗口底部 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButtonStyle}" Width="92" Height="36"
                    Margin="0,0,12,0" Click="CancelButton_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Width="92" Height="36"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
