<Window x:Class="ClassNote.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 设置页签：下划线式（现代风），选中项用主色下划线 + 加粗文字 -->
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="2,0,2,6" />
                            <Border x:Name="Underline" Grid.Row="1" Height="3" CornerRadius="1.5"
                                    Background="Transparent" Margin="0,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                <Setter TargetName="Underline" Property="Background"
                                        Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,18,0">
                                <TabPanel IsItemsHost="True" Panel.ZIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26,20,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="设置" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="API 配置用于生成笔记；OCR 决定截图文字怎么识别；录音设置决定录下哪些声音。全部配置仅保存在本机。" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}">

            <!-- ═══════════ 页签一：API 配置 ═══════════ -->
            <TabItem Header="API 配置" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
                    <StackPanel>

                        <TextBlock Text="API 基础地址（OpenAI 兼容，默认 DeepSeek）" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="BaseUrlBox" Margin="0,0,0,14" LostFocus="BaseUrlBox_LostFocus" />

                        <TextBlock Text="LLM API Key" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="ApiKeyBox" Margin="0,0,0,14" LostFocus="ApiKeyBox_LostFocus" />

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="模型名称" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RefreshModelsButton" Content="刷新模型列表"
                                    Style="{StaticResource GhostButtonStyle}" Height="26" Padding="10,0"
                                    HorizontalAlignment="Right" Click="RefreshModelsButton_Click" />
                        </Grid>
                        <!-- 可编辑下拉：填好地址 + Key 后自动拉取，也可以手输自定义模型名 -->
                        <ComboBox x:Name="ModelCombo" IsEditable="True" Margin="0,0,0,4" />
                        <TextBlock x:Name="ModelHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14"
                                   Text="填写地址与 API Key 后会自动获取可用模型；也可直接输入自定义模型名，或点右上角刷新。" />

                        <TextBlock Text="请求超时（秒）" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox x:Name="TimeoutBox" Margin="0,0,0,4" />
                        <TextBlock Text="本地模型推理较慢时请调大（范围 60–7200，默认 1800 = 30 分钟），可减少超时报错。"
                                   FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="TestButton" Content="测试连接" Style="{StaticResource GhostButtonStyle}"
                                    Width="96" Height="32" Click="TestButton_Click" />
                            <TextBlock x:Name="TestResultText" FontSize="12" VerticalAlignment="Center"
                                       Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                                Padding="14,10" Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                           VerticalAlignment="Top" />
                                <TextBlock FontSize="12" Foreground="#33415C" TextWrapping="Wrap" MaxWidth="450"
                                           Text="说明：语音转写（STT）在本地完成；截图 OCR 默认也用本机引擎离线识别，可在「OCR 识别」页签改为内网自建服务；只有 LLM 笔记生成必须联网。Key 仅保存在本机（DPAPI 加密）。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ 页签二：录音设置 ═══════════ -->
            <TabItem Header="录音设置" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
                    <StackPanel>

                        <TextBlock Text="声音来源（默认用于「开始记录」与定时记录）" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="SourceCombo" Margin="0,0,0,4"
                                  SelectionChanged="SourceCombo_SelectionChanged" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14"
                                   Text="麦克风录教室现场；系统声音录设备外放（在线课程、视频）；混合会把两者合成为一路录音。" />

                        <StackPanel x:Name="MicSection" Margin="0,0,0,14">
                            <TextBlock Text="麦克风设备（可留空 = 系统默认设备）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="MicCombo" />
                            <TextBlock x:Name="MicHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,6,0,0"
                                       Text="USB 外接麦克风请在此指定；设备不可用时会自动回退系统默认设备。" />
                        </StackPanel>

                        <StackPanel x:Name="SystemSection" Margin="0,0,0,14">
                            <TextBlock Text="系统声音来源设备（可留空 = 系统默认播放设备）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="OutputCombo" />
                            <TextBlock x:Name="OutputHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,6,0,0"
                                       Text="采集所选播放设备正在输出的声音（WASAPI 回环）；请选实际在出声的那个设备。" />
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,16" />

                        <TextBlock Text="课堂占用（录音期间能借多少 CPU 来提前转写）" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="ClassroomTranscriptionCombo" Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14"
                                   Text="无论选哪一档，转写最多只用一半逻辑核；检测到全屏放映、视频播放或电池供电时会自动降速，把资源让给正在放的内容。" />

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,16" />

                        <CheckBox x:Name="TouchOptimizationsCheck"
                                  Content="触摸屏优化（一体机 / 触摸屏建议保持勾选）"
                                  Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14"
                                   Text="开启后：列表支持单指拖动滚动、滚动条与菜单项加大；并且「按住 0.55 秒」等同于鼠标右键（Windows 10 桌面模式下系统不会自己把长按当右键，关掉后触摸屏将无法唤出右键菜单）。" />

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,4,0,16" />

                        <TextBlock Text="定时记录（课表自动录音）" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="ScheduleSourceHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,0" />

                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                                Padding="14,10" Margin="0,18,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Name="RecordingTipText" FontSize="12" Foreground="#33415C"
                                           TextWrapping="Wrap" MaxWidth="450"
                                           Text="录音全程在本地完成，不会上传到任何服务器。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ 页签三：OCR 识别 ═══════════ -->
            <TabItem Header="OCR 识别" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
                    <StackPanel>

                        <TextBlock Text="截图文字识别引擎" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox x:Name="OcrEngineCombo" Margin="0,0,0,4"
                                  SelectionChanged="OcrEngineCombo_SelectionChanged" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,14"
                                   Text="内置引擎离线、零配置，但对中英混排、公式与代码的识别较弱；内网 PaddleOCR 服务精度明显更高，代价是截图会发送到下面这个地址。" />

                        <StackPanel x:Name="OcrRemoteSection" Margin="0,0,0,14">
                            <TextBlock Text="服务地址" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="OcrUrlBox" Margin="0,0,0,4" />
                            <TextBlock x:Name="OcrUrlHint" FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,0,0,12"
                                       Text="例如 http://10.0.0.5:8868/predict/ocr_system（hubserving）或 http://10.0.0.5:8080/ocr（PaddleX / PP-OCRv5 serving）。" />

                            <TextBlock Text="请求方式（必须与服务器的部署方式一致）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox x:Name="OcrFormatCombo" Margin="0,0,0,4" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,0,0,12"
                                       Text="选错会表现为「能连上但一个字都识别不出」；用下面的「测试识别」可以立刻验证。" />

                            <TextBlock Text="访问密钥（服务没有鉴权就留空）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="OcrKeyBox" Margin="0,0,0,4" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,0,0,12"
                                       Text="非空时按 Authorization: Bearer 发送；与 LLM Key 一样以 DPAPI 加密后保存在本机。" />

                            <TextBlock Text="请求超时（秒）" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox x:Name="OcrTimeoutBox" Margin="0,0,0,14" />

                            <CheckBox x:Name="OcrFallbackCheck" Content="服务失败时回退内置 OCR（推荐）"
                                      Margin="0,0,0,4" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextHintBrush}"
                                       TextWrapping="Wrap" Margin="2,0,0,14"
                                       Text="开启后：内网服务连不上/超时就自动改用本机引擎，并且在冷却期内不会再逐张去等超时，避免整节课的截图都在等网络。" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button x:Name="TestOcrButton" Content="测试识别"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Width="96" Height="32" Click="TestOcrButton_Click" />
                                <TextBlock x:Name="TestOcrResultText" FontSize="12" VerticalAlignment="Center"
                                           Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10"
                                Padding="14,10" Margin="0,4,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"
                                           VerticalAlignment="Top" />
                                <TextBlock x:Name="OcrTipText" FontSize="12" Foreground="#33415C"
                                           TextWrapping="Wrap" MaxWidth="450"
                                           Text="识别结果写入本机数据库，笔记生成时只读现成结果。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 按钮区域独立于滚动区之外，固定在窗口底部 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource GhostButtonStyle}" Width="92" Height="36"
                    Margin="0,0,12,0" Click="CancelButton_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Width="92" Height="36"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>