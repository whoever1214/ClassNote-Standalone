<Window x:Class="ClassNote.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - LLM API 配置"
        Height="400" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LLM API Key"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" x:Name="ApiKeyBox"
                 Height="34" Margin="0,0,0,12"
                 BorderBrush="#CCC" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="2" Text="API 基础地址（OpenAI 兼容，默认 DeepSeek）"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="3" x:Name="BaseUrlBox"
                 Height="34" Margin="0,0,0,12"
                 BorderBrush="#CCC" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="4" Text="模型名称"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="5" x:Name="ModelBox"
                 Height="34" Margin="0,0,0,12"
                 BorderBrush="#CCC" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="6" Text="备用 API Key（可选，主配置失败时自动切换）"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="7" x:Name="FallbackApiKeyBox"
                 Height="34" Margin="0,0,0,12"
                 BorderBrush="#CCC" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="8" Text="备用 API 基础地址（可选）"
                   FontSize="13" Foreground="#555" Margin="0,0,0,4" />
        <TextBox Grid.Row="9" x:Name="FallbackBaseUrlBox"
                 Height="34" Margin="0,0,0,12"
                 BorderBrush="#CCC" VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="10" FontSize="11" Foreground="#999" TextWrapping="Wrap"
                   Text="说明：新软件为纯客户端单机运行，STT 与 OCR 在本地完成，仅 LLM 笔记生成需要 API Key。Key 仅保存在本机（DPAPI 加密）。" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="90" Height="36"
                    Margin="0,0,12,0"
                    Background="#EEE" Foreground="#333"
                    Click="CancelButton_Click" />
            <Button Content="保存" Width="90" Height="36"
                    Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
