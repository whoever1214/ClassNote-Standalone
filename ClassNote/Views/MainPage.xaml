<Page x:Class="ClassNote.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:ClassNote.Converters"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="ClassNote - 课堂笔记助手">

    <Page.Resources>
        <converters:StatusColorConverter x:Key="StatusColorConverter" />
        <converters:StatusDisplayConverter x:Key="StatusDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 加载中遮罩层 -->
        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="#80FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource LoadingSpinner}" HorizontalAlignment="Center" />
                <TextBlock Text="加载中..." FontSize="13" Foreground="#666"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- Left: Course Selection -->
        <Border Grid.Column="0"
                BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="选择课程"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,12" />

                <ListBox ItemsSource="{Binding Courses}"
                         SelectedItem="{Binding SelectedCourse}"
                         Height="300"
                         BorderBrush="#E0E0E0" BorderThickness="1" />

                <Button Content="开始记录"
                        Height="44" Margin="0,16,0,0"
                        Background="#1976D2" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        Click="StartButton_Click" />

                <Button Content="设置（LLM API Key）"
                        Height="36" Margin="0,8,0,0"
                        Background="#EEE" Foreground="#333"
                        FontSize="13"
                        Click="SettingsButton_Click" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Foreground="#D32F2F" FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Right: Recent Sessions -->
        <Border Grid.Column="1" Margin="20,0,0,0"
                BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Padding="16">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="最近记录"
                               FontSize="18" FontWeight="Bold"
                               DockPanel.Dock="Left" />
                    <Button Content="刷新"
                            Command="{Binding RefreshCommand}"
                            DockPanel.Dock="Right"
                            Width="64" Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="#1976D2" Foreground="White"
                            FontSize="12"
                            BorderThickness="0" Cursor="Hand" />
                </DockPanel>

                <ListView ItemsSource="{Binding RecentSessions}"
                          MouseDoubleClick="SessionList_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="课程" Width="60"
                                            DisplayMemberBinding="{Binding Course}" />
                            <GridViewColumn Header="标题" Width="180"
                                            DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="时间" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplayConverter}}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Page>
